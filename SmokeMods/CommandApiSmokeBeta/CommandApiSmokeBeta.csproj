<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>6</LangVersion>
    <RootNamespace>MarcoZechner.CommandApi.Smoke.Beta</RootNamespace>
    <AssemblyName>CommandApiSmokeBeta</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateNeutralResourcesLanguageAttribute>false</GenerateNeutralResourcesLanguageAttribute>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mal.Mdk2.ModAnalyzers" Version="*" />
    <PackageReference Include="Mal.Mdk2.References" Version="*" />
  </ItemGroup>

  <ItemGroup>
    <Compile
      Include="..\Common\CommandApiSmokeConsumer.cs"
      Link="Shared\CommandApiSmokeConsumer.cs" />
    <Compile
      Include="..\..\Data\Scripts\CommandAPI\Libraries\Mz.ApiProtocol\**\*.cs"
      Link="Libraries\Mz.ApiProtocol\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
